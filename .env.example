# ── Discord ─────────────────────────────────────────────────────────────
# Required. Create one at https://discord.com/developers/applications
BOT_TOKEN=

# Optional. Sync slash commands instantly to one guild while developing.
# Leave empty for global commands (can take up to an hour to propagate).
GUILD_ID=

# Category that cohort channels are created under.
COHORT_CATEGORY=Cohorts

# ── Storage ─────────────────────────────────────────────────────────────
DATABASE_PATH=data/leetgo.db
DEFAULT_TIMEZONE=UTC

# ── LeetCode ────────────────────────────────────────────────────────────
LEETCODE_CACHE_TTL=300
LEETCODE_TIMEOUT=15
LEETCODE_RETRIES=3

# ── Behaviour ───────────────────────────────────────────────────────────
MAX_COHORTS_PER_GUILD=50
MAX_LEADERBOARD_USERS=50
REMINDER_POLL_SECONDS=30

# ── Observability ───────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/leetgo.log
LOG_JSON=false
# Set HEALTH_PORT above 0 to expose /healthz and /metrics.
HEALTH_HOST=0.0.0.0
HEALTH_PORT=0
ENVIRONMENT=production
